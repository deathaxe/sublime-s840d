---
name: Step7 RES
scope: source.plc.res
version: 2

extends: Packages/YAML/YAML.sublime-syntax

file_extensions:
  - s7res

contexts:
  block-key-implicit:
    - meta_prepend: true
    - match: \b(id)(:)
      captures:
        1: meta.mapping.key.yaml entity.name.key.plc.res
        2: meta.mapping.plc.yaml punctuation.separator.key-value.plc.res
      set: id-value

  id-value:
    - meta_content_scope: meta.mapping.yaml
    - match: (?=\S)
      set: id-value-body

  id-value-body:
    - meta_content_scope: meta.mapping.value.yaml entity.name.constant.text-id.plc.res
    - match: $
      pop: 1
    - include: flow-scalar-in-12
